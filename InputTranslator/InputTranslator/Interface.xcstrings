    "翻译结果为空。请检查原文后重试。": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الترجمة فارغة. راجع النص الأصلي وحاول مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Übersetzung ist leer. Prüfen Sie den Originaltext und versuchen Sie es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The translation is empty. Check the original text and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La traducción está vacía. Revisa el texto original e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La traduction est vide. Vérifiez le texte original et réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "翻訳結果が空です。原文を確認して再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "번역 결과가 비어 있습니다. 원문을 확인한 뒤 다시 시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A tradução está vazia. Confira o texto original e tente novamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "翻译结果为空。请检查原文后重试。"
