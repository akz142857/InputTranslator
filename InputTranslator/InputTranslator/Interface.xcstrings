    "剪贴板已发生变化或无法写入，请复制译文后手动粘贴。": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيرت الحافظة أو تعذرت الكتابة فيها. انسخ الترجمة وألصقها يدويًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zwischenablage wurde geändert oder ist nicht beschreibbar. Kopieren Sie die Übersetzung und fügen Sie sie manuell ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The clipboard changed or couldn’t be written to. Copy the translation and paste it manually."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El portapapeles cambió o no se pudo escribir en él. Copia la traducción y pégala manualmente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le presse-papiers a changé ou n’est pas accessible en écriture. Copiez la traduction et collez-la manuellement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリップボードが変更されたか書き込めませんでした。翻訳をコピーして手動でペーストしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클립보드가 바뀌었거나 기록할 수 없습니다. 번역문을 복사해 직접 붙여넣으세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A área de transferência mudou ou não pôde ser atualizada. Copie a tradução e cole-a manualmente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "剪贴板已发生变化或无法写入，请复制译文后手动粘贴。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "剪貼簿已發生變化或無法寫入，請拷貝譯文後手動貼上。"
          }
        }
      }
    },
    "剪贴板里没有可翻译的文本。请先复制要翻译的回复。": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد نص قابل للترجمة في الحافظة. انسخ الرد أولًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zwischenablage enthält keinen Text zum Übersetzen. Kopieren Sie zuerst die Antwort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The clipboard has no text to translate. Copy the reply first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay texto para traducir en el portapapeles. Copia primero la respuesta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le presse-papiers ne contient aucun texte à traduire. Copiez d’abord la réponse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "翻訳できるテキストがクリップボードにありません。先に返信をコピーしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클립보드에 번역할 텍스트가 없습니다. 먼저 답변을 복사하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há texto para traduzir na área de transferência. Copie a resposta primeiro."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "剪贴板里没有可翻译的文本。请先复制要翻译的回复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "剪貼簿中沒有可翻譯的文字。請先拷貝要翻譯的回覆。"
          }
        }
      }
    },
