        }
      }
    },
    "开启后，单行译文会在粘贴后立即提交。多行内容请手动提交。": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند تفعيله، تُرسل الترجمة ذات السطر الواحد مباشرة بعد اللصق. أرسل النص متعدد الأسطر يدويًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn diese Option aktiviert ist, werden einzeilige Übersetzungen direkt nach dem Einfügen gesendet. Senden Sie mehrzeilige Texte manuell."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When enabled, single-line translations are submitted right after pasting. Submit multiline text manually."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con esta opción activada, las traducciones de una línea se envían al pegarlas. Envía manualmente el texto de varias líneas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque cette option est activée, les traductions d’une seule ligne sont envoyées dès leur collage. Envoyez les textes de plusieurs lignes manuellement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンにすると、1行の翻訳は貼り付け後すぐに送信されます。複数行は手動で送信してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "켜면 한 줄 번역은 붙여넣은 직후 제출됩니다. 여러 줄은 직접 제출하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com esta opção ativada, traduções de uma linha são enviadas logo após serem coladas. Envie textos com várias linhas manualmente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启后，单行译文会在粘贴后立即提交。多行内容请手动提交。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟後，單行譯文會在貼上後立即送出。多行內容請手動送出。"
          }
        }
      }
    },
