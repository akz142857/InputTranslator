    "Apple Translation 暂时无法完成翻译，请重试。": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذرت الترجمة باستخدام Apple Translation. حاول مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple konnte den Text nicht übersetzen. Versuchen Sie es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Translation couldn’t translate the text. Try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple no pudo traducir el texto. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La traduction Apple n’a pas abouti. Réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Appleの翻訳機能で翻訳できませんでした。再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 번역을 완료하지 못했습니다. 다시 시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A tradução da Apple não foi concluída. Tente novamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Translation 暂时无法完成翻译，请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Translation 暫時無法完成翻譯，請重試。"
          }
        }
      }
    },
