            "value": "Verbinden Sie zuerst einen Terminalassistenten in den Einstellungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect a terminal assistant in Settings first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecta primero un asistente del terminal en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez d’abord un assistant du terminal dans les réglages."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まず設定でターミナルアシスタントを接続してください。"
