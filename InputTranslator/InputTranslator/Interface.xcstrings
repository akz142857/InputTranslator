    "这台 Mac 上的 Apple Translation 暂不支持 %@。请选择其他语言。": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يدعم Apple Translation على هذا الـ Mac الترجمة لـ %@. اختر زوج لغات آخر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple unterstützt auf diesem Mac keine Übersetzung für %@. Wählen Sie ein anderes Sprachpaar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Translation on this Mac doesn’t support %@. Choose another language pair."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La traducción de Apple en este Mac no admite %@. Elige otra combinación de idiomas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La traduction Apple sur ce Mac ne prend pas en charge %@. Choisissez une autre paire de langues."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac の翻訳機能は %@ に対応していません。別の言語の組み合わせを選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac의 Apple 번역은 %@을(를) 지원하지 않습니다. 다른 언어 조합을 선택하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
