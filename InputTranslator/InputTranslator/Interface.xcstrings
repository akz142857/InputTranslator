    "已向终端发送粘贴按键。请检查内容后手动按 Enter。": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أُرسل أمر اللصق إلى الطرفية. راجع النص واضغط على Enter يدويًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Einfügebefehl wurde an das Terminal gesendet. Prüfen Sie den Text und drücken Sie die Eingabetaste."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste was sent to the terminal. Check the text and press Enter manually."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se envió la orden de pegar al terminal. Revisa el texto y pulsa Intro manualmente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le collage a été envoyé au terminal. Vérifiez le texte et appuyez sur Entrée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ターミナルにペースト操作を送信しました。内容を確認して Enter を押してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "터미널에 붙여넣기 키를 보냈습니다. 내용을 확인한 뒤 Enter를 직접 누르세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O comando de colar foi enviado ao terminal. Confira o texto e pressione Enter manualmente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已向终端发送粘贴按键。请检查内容后手动按 Enter。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已向終端機發送貼上按鍵。請檢查內容後手動按 Enter。"
          }
        }
      }
    },
