    "首次使用某个语言对时，macOS 可能要求下载语言资源。": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قد يطلب macOS تنزيل موارد اللغات عند استخدام زوج لغات للمرة الأولى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS kann beim ersten Einsatz eines Sprachpaars den Download von Sprachressourcen anfordern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS may ask to download language resources the first time you use a language pair."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS puede pedir que descargues los recursos al usar una combinación de idiomas por primera vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS peut demander de télécharger les langues à la première utilisation de cette paire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "言語の組み合わせを初めて使う際、macOS が言語データのダウンロードを求める場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "언어 조합을 처음 사용하면 macOS에서 언어 리소스 다운로드를 요청할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Na primeira vez que você usar um par de idiomas, o macOS pode solicitar o download dos recursos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "首次使用某个语言对时，macOS 可能要求下载语言资源。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "第一次使用某個語言對時，macOS 可能要求下載語言資源。"
          }
        }
      }
    },
    "首次粘贴到此输入框。请确认 %@ 中的助手正在等待输入。": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا أول لصق في حقل الإدخال هذا. تأكد من أن المساعد في %@ ينتظر الإدخال."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies ist das erste Einfügen in dieses Feld. Prüfen Sie, ob der Assistent in %@ auf eine Eingabe wartet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is the first paste into this input area. Make sure the assistant in %@ is ready to accept input."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es la primera vez que pegas en este campo. Comprueba que el asistente en %@ espere tu entrada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’est le premier collage dans cette zone. Vérifiez que l’assistant dans %@ est prêt à recevoir votre texte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この入力欄に初めてペーストします。%@ のアシスタントが入力待ちであることを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 입력 영역에 처음 붙여넣습니다. %@의 어시스턴트가 입력을 기다리는지 확인하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É a primeira colagem neste campo. Confira se o assistente em %@ está pronto para receber o texto."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "首次粘贴到此输入框。请确认 %@ 中的助手正在等待输入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "第一次貼上到此輸入框。請確認 %@ 中的助理正在等待輸入。"
          }
        }
      }
    },
    "首次读取时，macOS 会分别请求 Terminal 和 iTerm2 的自动化权限。": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند قراءة رد لأول مرة، يطلب macOS إذن التحكم الآلي لكل من Terminal وiTerm2 بشكل منفصل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim ersten Lesen einer Antwort fragt macOS getrennt nach den Automationsberechtigungen für Terminal und iTerm2."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The first time you read a reply, macOS asks for Automation permission separately for Terminal and iTerm2."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al leer una respuesta por primera vez, macOS pide por separado permiso de Automatización para Terminal e iTerm2."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À la première lecture, macOS demande séparément l’autorisation d’automatisation pour Terminal et iTerm2."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "返信を初めて読み込むと、macOS が Terminal と iTerm2 それぞれのオートメーション許可を求めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "답변을 처음 읽으면 macOS가 Terminal과 iTerm2 각각의 자동화 권한을 요청합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Na primeira leitura, o macOS pede permissões de Automação separadas para Terminal e iTerm2."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "首次读取时，macOS 会分别请求 Terminal 和 iTerm2 的自动化权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "第一次讀取時，macOS 會分別請求 Terminal 和 iTerm2 的自動化權限。"
          }
        }
      }
    },
