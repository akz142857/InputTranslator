        }
      }
    },
    "无法定位当前终端会话。请切回本机助手所在的标签页或分屏。": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر العثور على جلسة الطرفية الحالية. ارجع إلى علامة التبويب أو الجزء الذي يشغّل المساعد المحلي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die aktuelle Terminalsitzung wurde nicht gefunden. Wechseln Sie zum Tab oder Bereich mit dem lokalen Assistenten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current terminal session couldn’t be found. Return to the tab or split pane running your local assistant."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró la sesión del terminal. Vuelve a la pestaña o panel donde se ejecuta el asistente local."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Session du terminal introuvable. Revenez à l’onglet ou au volet où tourne votre assistant local."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のターミナルセッションが見つかりません。ローカルのアシスタントを実行しているタブまたは分割ペインに戻ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 터미널 세션을 찾을 수 없습니다. 로컬 어시스턴트가 실행 중인 탭 또는 분할 창으로 돌아가세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A sessão do terminal não foi encontrada. Volte à aba ou ao painel em que o assistente local está aberto."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法定位当前终端会话。请切回本机助手所在的标签页或分屏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法定位當前終端機會話。請切回本機助理所在的標籤頁或分割窗格。"
          }
        }
      }
    },
    "无法找到 InputTranslator 可执行文件。": {
