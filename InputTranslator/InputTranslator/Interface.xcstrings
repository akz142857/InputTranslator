      }
    },
    "无法确认终端输入区域。请点击 Claude Code 的输入区，再从该终端打开输入框。": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر التحقق من حقل الإدخال. انقر حقل إدخال Claude Code وأعد فتح اللوحة من تلك الطرفية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Eingabefeld im Terminal konnte nicht bestätigt werden. Klicken Sie in die Eingabe von Claude Code und öffnen Sie das Fenster aus diesem Terminal erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The terminal input couldn’t be verified. Click the Claude Code input field and reopen the panel from that terminal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo verificar la entrada del terminal. Haz clic en el campo de Claude Code y vuelve a abrir el panel desde ese terminal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de vérifier la zone de saisie du terminal. Cliquez dans Claude Code et rouvrez le panneau depuis ce terminal."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ターミナルの入力欄を確認できません。Claude Code の入力欄をクリックし、そのターミナルからパネルを開き直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "터미널 입력 영역을 확인할 수 없습니다. Claude Code 입력란을 클릭한 뒤 해당 터미널에서 패널을 다시 여세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível confirmar a área de entrada. Clique no campo do Claude Code e reabra o painel por esse terminal."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法确认终端输入区域。请点击 Claude Code 的输入区，再从该终端打开输入框。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法確認終端機輸入區域。請點擊 Claude Code 的輸入區，再從這個終端機開啟輸入框。"
          }
        }
      }
    },
