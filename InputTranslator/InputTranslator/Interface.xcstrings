    "无法更新开机启动。请检查系统设置中的登录项。": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر تحديث إعداد فتح التطبيق عند تسجيل الدخول. راجع عناصر تسجيل الدخول في إعدادات النظام."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anmeldeeinstellung konnte nicht geändert werden. Prüfen Sie die Anmeldeobjekte in den Systemeinstellungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The login setting couldn’t be updated. Check Login Items in System Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo cambiar la apertura al iniciar sesión. Revisa los ítems de inicio en Ajustes del Sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de modifier l’ouverture à la connexion. Vérifiez les éléments d’ouverture dans Réglages Système."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログイン時の起動設定を更新できませんでした。システム設定の「ログイン項目」を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인 시 열기 설정을 변경할 수 없습니다. 시스템 설정의 로그인 항목을 확인하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível alterar a abertura ao iniciar sessão. Verifique os Itens de Início nos Ajustes do Sistema."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法更新开机启动。请检查系统设置中的登录项。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法更新開機啟動。請檢查系統設定中的登入項。"
          }
        }
      }
    },
    "无法注册 %@。请在设置中选择其他快捷键。": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر تسجيل %@. اختر اختصارًا آخر في الإعدادات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ konnte nicht registriert werden. Wählen Sie in den Einstellungen einen anderen Kurzbefehl."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t register %@. Choose another shortcut in Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo registrar %@. Elige otro atajo en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’enregistrer %@. Choisissez un autre raccourci dans les réglages."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ を登録できません。設定で別のショートカットを選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@을(를) 등록할 수 없습니다. 설정에서 다른 단축키를 선택하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível registrar %@. Escolha outro atalho nos Ajustes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法注册 %@。请在设置中选择其他快捷键。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法註冊 %@。請在設定中選擇其他快捷鍵。"
          }
        }
      }
    },
    "无法注册 %@，可能已被系统或其他应用占用。": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر تسجيل %@. ربما يستخدمه macOS أو تطبيق آخر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ konnte nicht registriert werden. macOS oder eine andere App verwendet den Kurzbefehl möglicherweise bereits."
          }
