          "stringUnit": {
            "state": "translated",
            "value": "请先在设置中连接一个终端助手。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先在設定中連線一個終端機助理。"
          }
        }
      }
    },
    "请回到 Terminal 或 iTerm2 的助手会话，再读取当前回复。": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ارجع إلى المساعد في Terminal أو iTerm2 لقراءة الرد الحالي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wechseln Sie zum Assistenten in Terminal oder iTerm2, um die aktuelle Antwort zu lesen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Return to the assistant in Terminal or iTerm2 to read the current reply."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve al asistente en Terminal o iTerm2 para leer la respuesta actual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Revenez à l’assistant dans Terminal ou iTerm2 pour lire la réponse en cours."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の返信を読むには、Terminal または iTerm2 のアシスタントに戻ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 답변을 읽으려면 Terminal 또는 iTerm2의 어시스턴트로 돌아가세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Volte ao assistente no Terminal ou iTerm2 para ler a resposta atual."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请回到 Terminal 或 iTerm2 的助手会话，再读取当前回复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請回到 Terminal 或 iTerm2 的助理會話，再讀取當前回覆。"
          }
        }
      }
    },
    "请在系统设置中授权辅助功能，再从终端唤起输入框。": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح بتسهيلات الاستخدام في إعدادات النظام، ثم أعد فتح اللوحة من الطرفية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlauben Sie den Zugriff über die Bedienungshilfen und öffnen Sie das Fenster erneut aus dem Terminal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Accessibility in System Settings, then open the panel from the terminal again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Concede el permiso de Accesibilidad en Ajustes del Sistema y vuelve a abrir el panel desde el terminal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez l’accessibilité dans Réglages Système, puis rouvrez le panneau depuis le terminal."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定でアクセシビリティを許可し、ターミナルからパネルを開き直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정에서 손쉬운 사용을 허용한 뒤 터미널에서 패널을 다시 여세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita a Acessibilidade nos Ajustes do Sistema e reabra o painel pelo terminal."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在系统设置中授权辅助功能，再从终端唤起输入框。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在系統設定中授權輔助使用，再從終端機喚起輸入框。"
          }
        }
      }
    },
    "请在系统设置的「隐私与安全性 → 自动化」允许 InputTranslator 读取当前终端会话。": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في إعدادات النظام، ضمن الخصوصية والأمن ثم التحكم الآلي، اسمح لـ InputTranslator بقراءة جلسة الطرفية الحالية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlauben Sie InputTranslator unter Systemeinstellungen → Datenschutz & Sicherheit → Automation das Lesen der aktuellen Terminalsitzung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In System Settings → Privacy & Security → Automation, allow InputTranslator to read the current terminal session."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En Ajustes del Sistema → Privacidad y seguridad → Automatización, permite que InputTranslator lea la sesión actual del terminal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans Réglages Système → Confidentialité et sécurité → Automatisation, autorisez InputTranslator à lire la session du terminal."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定の「プライバシーとセキュリティ」→「オートメーション」で、InputTranslator に現在のターミナルセッションの読み取りを許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정의 개인정보 보호 및 보안 → 자동화에서 InputTranslator가 현재 터미널 세션을 읽도록 허용하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em Ajustes do Sistema → Privacidade e Segurança → Automação, permita que o InputTranslator leia a sessão atual do terminal."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在系统设置的「隐私与安全性 → 自动化」允许 InputTranslator 读取当前终端会话。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在系統設定的「隱私與安全性 → 自動化」允許 InputTranslator 讀取當前終端機會話。"
          }
        }
      }
    },
    "请在系统设置的登录项中启用 InputTranslator。": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فعّل InputTranslator في عناصر تسجيل الدخول ضمن إعدادات النظام."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivieren Sie InputTranslator unter „Anmeldeobjekte“ in den Systemeinstellungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable InputTranslator under Login Items in System Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa InputTranslator en los ítems de inicio de Ajustes del Sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez InputTranslator dans les éléments d’ouverture de Réglages Système."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定の「ログイン項目」で InputTranslator を有効にしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정의 로그인 항목에서 InputTranslator를 활성화하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative o InputTranslator em Itens de Início nos Ajustes do Sistema."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在系统设置的登录项中启用 InputTranslator。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在系統設定的登入項中啟用 InputTranslator。"
          }
        }
      }
    },
    "请在该助手的设置中启用 hooks。": {
