        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se detuvo el pegado porque la traducción contiene caracteres de control del terminal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Collage interrompu : la traduction contient des caractères de contrôle du terminal."
