    "已配置 %@。等一轮新回复完成后再次按 ⌘⌥⇧Space。": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم إعداد %@. انتظر ردًا جديدًا ثم اضغط مجددًا على ⌘⌥⇧Space."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist konfiguriert. Warten Sie auf eine neue Antwort und drücken Sie erneut ⌘⌥⇧Leertaste."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is configured. Wait for a new reply, then press ⌘⌥⇧Space again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está configurado. Espera una nueva respuesta y pulsa ⌘⌥⇧Espacio de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est configuré. Attendez une nouvelle réponse, puis appuyez à nouveau sur ⌘⌥⇧Espace."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ を設定しました。新しい返信が完了したら ⌘⌥⇧Space をもう一度押してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 설정을 마쳤습니다. 새 답변이 완료되면 ⌘⌥⇧Space를 다시 누르세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está configurado. Aguarde uma nova resposta e pressione ⌘⌥⇧Espaço novamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已配置 %@。等一轮新回复完成后再次按 ⌘⌥⇧Space。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已設定 %@。等一輪新回覆完成後再次按 ⌘⌥⇧Space。"
          }
        }
      }
    },
