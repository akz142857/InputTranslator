        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 설정에서 터미널 어시스턴트를 연결하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecte primeiro um assistente do terminal nos Ajustes."
          }
        },
