{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "%@ 的语言资源尚未就绪。请联网并允许系统下载，然后重试。": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "موارد اللغة لـ %@ ليست جاهزة. اتصل بالإنترنت واسمح لـ macOS بتنزيلها ثم حاول مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sprachressourcen für %@ sind noch nicht verfügbar. Stellen Sie eine Internetverbindung her, erlauben Sie den Download und versuchen Sie es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Language resources for %@ are not ready. Go online, allow macOS to download them, and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los recursos de %@ aún no están listos. Conéctate a internet, permite que macOS los descargue e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les ressources pour %@ ne sont pas prêtes. Connectez-vous à Internet, autorisez le téléchargement dans macOS et réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ の言語データが準備できていません。オンラインにして macOS のダウンロードを許可し、再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 언어 리소스가 준비되지 않았습니다. 인터넷에 연결해 macOS의 다운로드를 허용한 뒤 다시 시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os recursos de %@ ainda não estão prontos. Conecte-se à internet, permita o download pelo macOS e tente novamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 的语言资源尚未就绪。请联网并允许系统下载，然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 的語言資源尚未就緒。請聯網並允許系統下載，然後重試。"
          }
        }
      }
    },
