          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新增或修复后，请在 Codex 的 /hooks 中确认信任。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增或修復後，請在 Codex 的 /hooks 中確認信任。"
