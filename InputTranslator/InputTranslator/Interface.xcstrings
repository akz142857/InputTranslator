    "新增或修复后，请在 Codex 的 /hooks 中确认信任。": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعد الاتصال أو الإصلاح، أكّد الثقة في Codex عبر /hooks."
          }
        },
        "de": {
          "stringUnit": {
