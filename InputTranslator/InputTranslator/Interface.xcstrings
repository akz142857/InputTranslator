    "请确认 %@ 中的助手能接收多行粘贴。": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تأكد من أن المساعد في %@ يقبل لصق عدة أسطر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfen Sie, ob der Assistent in %@ mehrzeiliges Einfügen unterstützt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make sure the assistant in %@ can accept multi-line pastes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba que el asistente en %@ admita pegar varias líneas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez que l’assistant dans %@ accepte le collage de plusieurs lignes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ のアシスタントが複数行のペーストに対応していることを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@의 어시스턴트에 여러 줄을 붙여넣을 수 있는지 확인하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
