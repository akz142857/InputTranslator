    "系统无法生成粘贴按键，请复制译文后手动粘贴。": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر على macOS إرسال اختصار اللصق. انسخ الترجمة وألصقها يدويًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS konnte den Einfügekurzbefehl nicht senden. Kopieren Sie die Übersetzung und fügen Sie sie manuell ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS couldn’t send the paste shortcut. Copy the translation and paste it manually."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS no pudo enviar el atajo de pegado. Copia la traducción y pégala manualmente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS n’a pas pu envoyer le raccourci de collage. Copiez la traduction et collez-la manuellement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS がペーストのキー操作を送信できませんでした。翻訳をコピーして手動でペーストしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS가 붙여넣기 단축키를 보낼 수 없습니다. 번역문을 복사해 직접 붙여넣으세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O macOS não enviou o atalho de colar. Copie a tradução e cole-a manualmente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统无法生成粘贴按键，请复制译文后手动粘贴。"
          }
