    "从 Terminal 或 iTerm2 打开可读取当前会话，也可以翻译复制好的回复。": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح من Terminal أو iTerm2 لقراءة الجلسة الحالية، أو ترجم ردًا نسخته."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnen Sie das Fenster aus Terminal oder iTerm2, um die aktuelle Sitzung zu lesen. Sie können auch eine kopierte Antwort übersetzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open from Terminal or iTerm2 to read the current session, or translate a reply you’ve copied."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre desde Terminal o iTerm2 para leer la sesión actual, o traduce una respuesta que hayas copiado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez depuis Terminal ou iTerm2 pour lire la session en cours, ou traduisez une réponse copiée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminal または iTerm2 から開くと現在のセッションを読めます。コピーした返信も翻訳できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminal 또는 iTerm2에서 열어 현재 세션을 읽거나, 복사한 답변을 번역할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra pelo Terminal ou iTerm2 para ler a sessão atual ou traduza uma resposta copiada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从 Terminal 或 iTerm2 打开可读取当前会话，也可以翻译复制好的回复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從 Terminal 或 iTerm2 開啟可讀取當前會話，也可以翻譯拷貝好的回覆。"
          }
        }
      }
    },
